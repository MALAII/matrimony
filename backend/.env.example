# Server Configuration
PORT=5002
NODE_ENV=development

# Reverse Proxy Trust Configuration (for rate limiting client IP resolution)
# Set to '1' (or 'true') if running behind a single reverse proxy (e.g., Render, Nginx, AWS ALB, Heroku)
# Set to 'false' or leave unset when listening directly without reverse proxies.
TRUST_PROXY=false

# Client URL & CORS Allowed Origins
# In development, localhost origins (ports 3000, 3001) are automatically permitted.
# In production, ONLY explicit origins listed in CLIENT_URL or ALLOWED_ORIGINS (comma-separated) are allowed. Localhost origins are blocked in production.
CLIENT_URL=http://localhost:3000
# ALLOWED_ORIGINS=https://matrimony.example.com,https://admin.example.com

# Rate Limiting Configuration (Authentication Endpoints)
# Registration endpoint rate limits
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=900000

# Login endpoint rate limits
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# MongoDB Atlas Configuration
# Replace with your MongoDB Atlas connection string from MongoDB Cloud:
# Example format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Profile Photo Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_FILE_SIZE_MB=5

# --- Email deliverability (avoid the spam folder) ---
# 1. Send from an address on a domain YOU own (EMAIL_FROM), not a personal @gmail.com/@yahoo.com mailbox.
# 2. Use a transactional provider (Brevo, Resend, SendGrid, Amazon SES, Zoho ZeptoMail) and add the SPF + DKIM
#    records it gives you, plus a DMARC record, to your domain's DNS.
# 3. CLIENT_URL must be your real https site in production; localhost links in emails are flagged as spam.
# 4. Run `npm run check:email` to test the setup, then score a real message at mail-tester.com.

# Email & SMTP Configuration (Password Setup & Invitations)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Matrimony Platform" <no-reply@example.com>
# Optional: Dedicated Reply-To address for recipient queries (falls back to SMTP_USER if unset)
# EMAIL_REPLY_TO=support@example.com

# Razorpay Payment Gateway Configuration (Phase 5A)
# Checkout must remain disabled (false) until live credentials and pricing are finalized
RAZORPAY_CHECKOUT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Subscription Plan Pricing (Integer amounts in INR Paise; e.g. 150000 = Rs. 1500)
# Prices must be set as positive integers before checkout can be enabled. Do NOT invent prices.
PLAN_PRICE_3M=
PLAN_PRICE_6M=

# Astrology API Configuration (Prokerala Astrology API v2)
# OAuth 2.0 Client Credentials:
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
PROKERALA_AYANAMSA=1

# Background Subscription Expiry Scheduler
# Disabled by default; enable only if not using an external cron runner (Render/AWS/Heroku/crontab)
ENABLE_IN_PROCESS_SCHEDULER=false
SUBSCRIPTION_EXPIRY_INTERVAL_MS=86400000
RUN_EXPIRY_SCHEDULER_ON_STARTUP=false

# Initial Administrator Provisioning (used by 'npm run seed:admin')
INITIAL_ADMIN_NAME=Admin User
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMeWithStrongPassword123!
